# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Klucz z console.anthropic.com (najlepiej osobny workspace z limitem wydatków).
# Bez klucza aplikacja działa w trybie demonstracyjnym (bez AI).
ANTHROPIC_API_KEY=
# Model językowy (domyślnie claude-opus-5-5).
# EDITORIAL_MODEL=claude-opus-5-5

# Rozpoznawanie mowy: large-v3 na GPU; na samym CPU lepiej large-v3-turbo.
EDITORIAL_ASR_MODEL=large-v3
# auto = karta NVIDIA, jeśli działa, inaczej CPU; cuda = tylko GPU (błąd, gdy nie działa); cpu
EDITORIAL_ASR_DEVICE=auto

# Limit wielkości przesyłanego pliku w MB.
# EDITORIAL_MAX_UPLOAD_MB=2048
